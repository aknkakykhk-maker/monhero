    setEcoMode(next);
    return next;
  };
  const cycleEcoMode = () => {
    const currentIndex=ECO_MODES.indexOf(ecoModeRef.current);
    return setEcoModeSafe(ECO_MODES[(currentIndex+1)%ECO_MODES.length]);
  };
  const liteBattleView = gameState==='BATTLE'&&ecoMode==='lite';
