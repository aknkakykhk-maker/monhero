  },
  {
    id: BATTLE_MODE_QUICK, label: 'クイックモード', short: 'クイック', emoji: '⚡', color: '#2dd4bf',
    tagline: '短い時間でモンスターを育てるためのモード',
    highlights: [
      ['⚡', '育成向き。短い時間で何周でも回せる'],
      ['💎', '経験値・ダイヤが1.5倍'],
