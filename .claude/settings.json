{
  "language": "japanese",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/hooks/japanese-only-check.js\"",
            "timeout": 20,
            "statusMessage": "日本語だけで書いたか確かめています"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/hooks/hq-table-as-image.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/hooks/session-length-nudge.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/hooks/no-subagent-in-dept.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__Supabase__list_tables",
      "mcp__Supabase__list_migrations",
      "mcp__Supabase__list_extensions",
      "mcp__Supabase__list_edge_functions",
      "mcp__Supabase__get_edge_function",
      "mcp__Supabase__get_advisors",
      "mcp__Supabase__query_logs",
      "mcp__Supabase__get_project",
      "mcp__Supabase__get_project_url",
      "mcp__Supabase__list_projects",
      "mcp__Supabase__get_organization",
      "mcp__Supabase__list_organizations",
      "mcp__Supabase__list_branches",
      "mcp__Supabase__search_docs",
      "mcp__Supabase__generate_typescript_types",
      "mcp__Supabase__execute_sql",
      "mcp__Supabase__apply_migration",
      "mcp__claude-code-remote__send_message",
      "mcp__claude-code-remote__send_later",
      "mcp__claude-code-remote__create_session",
      "mcp__claude-code-remote__archive_session",
      "mcp__claude-code-remote__list_sessions",
      "mcp__claude-code-remote__get_session",
      "mcp__claude-code-remote__list_events",
      "mcp__claude-code-remote__get_event",
      "mcp__claude-code-remote__list_triggers",
      "mcp__claude-code-remote__get_trigger",
      "mcp__github__create_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__github__update_pull_request"
    ]
  }
}
